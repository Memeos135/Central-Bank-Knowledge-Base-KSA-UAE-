# Copy to .env and source it, or export these in your shell.
# Nothing in this repo reads .env automatically — keep keys out of files you commit.

# --- which regulator's pipeline -----------------------------------------
# Also settable per-invocation with `python run.py --source cbuae ...`; the
# CLI flag wins. Everything below this point is namespaced per source: SAMA's
# env vars are unchanged from before, CBUAE gets its own parallel set so the
# two builds can use different keys/workspaces/budgets.
# export KB_SOURCE="sama"   # or "cbuae"

# --- graphify extraction ----------------------------------------------------
# graphify 0.9.23 breaks on models that emit thinking blocks, so this stage
# stays pinned to 4.8. Shared across both sources — graphify is invoked
# against whichever source's own corpus dir, one at a time, never both.
export ANTHROPIC_API_KEY="sk-ant-..."
export GRAPHIFY_MODEL="claude-opus-4-8"
# export GRAPHIFY_BIN="/full/path/to/graphify"   # if not on PATH

# --- enrichment: SAMA ---------------------------------------------------
# Separate key and model: this stage calls the API directly and is not subject
# to the graphify constraint. Falls back to ANTHROPIC_API_KEY if unset.
export SAMA_ENRICH_API_KEY="sk-ant-..."
export SAMA_ENRICH_MODEL="claude-opus-5"
# Required for identity-linked keys (Console -> Settings -> Workspaces).
export SAMA_ENRICH_WORKSPACE_ID=""
export SAMA_ENRICH_WORKERS="6"
export SAMA_EDGE_NARRATIVE_MAX="400"
# export SAMA_REQUIRE_IN_FORCE="0"    # ingest superseded instruments too
# export SAMA_DEDUP_NODES="0"         # keep duplicate-label nodes

# --- enrichment: CBUAE ---------------------------------------------------
# Mirrors the SAMA block above. Point this at a different key/workspace if you
# want CBUAE's spend tracked separately (graph-build/cbuae/usage.jsonl is
# already a separate cost ledger from SAMA's regardless of key).
export CBUAE_ENRICH_API_KEY="sk-ant-..."
export CBUAE_ENRICH_MODEL="claude-opus-5"
export CBUAE_ENRICH_WORKSPACE_ID=""
export CBUAE_ENRICH_WORKERS="6"
export CBUAE_EDGE_NARRATIVE_MAX="400"
# export CBUAE_REQUIRE_IN_FORCE="0"
# export CBUAE_DEDUP_NODES="0"

# --- optional ---------------------------------------------------------------
# The Obsidian vault ROOT both sources share. SAMA writes at this root
# unchanged; CBUAE writes into a CBUAE/ subfolder of it, with every note
# prefixed "CBUAE — " so a generic label can never cross-link between the two
# graphs (Obsidian resolves [[wikilinks]] by note name vault-wide, ignoring
# folders — see sama/graph.py:namespace_vault for why this matters).
export GRAPHIFY_VAULT_DIR="Central Banks Knowledge Base"
# export TESSERACT_CMD="/opt/homebrew/bin/tesseract"
